  "corrections": [
    {
      "finding": "Fixture write grant followed outward SDK peer symlinks",
      "resolution": "Exactly two write grants: the brand-new run root and run-root/*; no dependency-tree grant. All three candidate probes require shared preflight before imports. Existing roots, old broad grants, extra flags and inherited environment are rejected.",
      "verification": "Noncreating, nontruncating O_WRONLY opens denied for candidate metadata and both direct/alias metadata paths of all 11 peers before candidate loading, in each successful run."
    },
    {
      "finding": "Standard DNS APIs bypassed the guard and attempt accounting",
      "resolution": "Guard standard lookup/resolve/reverse methods on dns, dns.promises and both Resolver prototypes; synchronize named builtin exports. UDP instance send/bind/connect methods are also guarded.",
      "verification": "83 offline calls rejected with T103_NETWORK_DENIED and counted exactly once; tested native operations replaced with local sentinels before guard installation, so missed patches cannot send network traffic."
    }
  ],
